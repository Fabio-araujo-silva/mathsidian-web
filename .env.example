# Copie para .env (ou configure no painel da hospedagem).

# Porta e endereço do servidor
PORT=3000
HOST=0.0.0.0

# Onde ficam o banco, os cofres, os backups e o cache do LaTeX (use um volume persistente!)
DATA_DIR=/data

# Quem pode criar conta: open (qualquer um), invite (precisa de código), closed (ninguém)
REGISTRATION=invite
# Códigos de convite separados por vírgula. Mande o link https://seu-site/?convite=CODIGO
INVITE_CODES=troque-este-codigo

# Atrás de um proxy (Caddy, Nginx, Cloudflare): 1 para confiar no IP do cabeçalho X-Forwarded-For
TRUST_PROXY=1

# Limites
MAX_VAULT_MB=200
MAX_FILE_MB=20
SIGNUPS_PER_HOUR=5
SESSION_DAYS=30

# LaTeX: compilações em paralelo e tempo máximo de cada uma
TEX_WORKERS=3
TEX_TIMEOUT_MS=20000

# Backups automáticos no servidor: a cada quantas horas (se o cofre mudou) e quantos guardar
SNAPSHOT_HOURS=24
SNAPSHOT_KEEP=14
